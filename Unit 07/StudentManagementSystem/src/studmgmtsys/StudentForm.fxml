<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>

<!-- 
    FXML layout for the Student form.
    This layout allows the user to input a student's ID and name, with options to save or cancel.
-->
<GridPane xmlns:fx="http://javafx.com/fxml"
          fx:controller="studmgmtsys.StudentFormController"
          hgap="10" vgap="10">

    <!-- Define padding around the GridPane -->
    <padding>
        <Insets top="10" right="10" bottom="10" left="10" />
    </padding>

    <!-- Label for Student ID field -->
    <Label text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />

    <!-- TextField for Student ID input -->
    <TextField fx:id="idField" promptText="Enter student ID" GridPane.columnIndex="1"
               GridPane.rowIndex="0" />

    <!-- Label for Student Name field -->
    <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="1" />

    <!-- TextField for Student Name input -->
    <TextField fx:id="nameField" promptText="Enter student name" GridPane.columnIndex="1"
               GridPane.rowIndex="1" />

    <!-- Submit button for saving student information -->
    <Button text="Save" onAction="#handleSubmit" GridPane.columnIndex="0" GridPane.rowIndex="2" />

    <!-- Cancel button to close the form without saving -->
    <Button text="Cancel" onAction="#handleCancel" GridPane.columnIndex="1" GridPane.rowIndex="2" />
</GridPane>
