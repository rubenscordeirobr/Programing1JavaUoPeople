<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>

<!-- 
    FXML layout for the Department form 
    This layout allows the user to input a department's ID and Name and provides Save/Cancel buttons.
-->
<GridPane xmlns:fx="http://javafx.com/fxml"
          fx:controller="studmgmtsys.DepartmentFormController"
          hgap="10" vgap="10">

    <!-- Define padding around the GridPane -->
    <padding>
        <Insets top="10" right="10" bottom="10" left="10" />
    </padding>

    <!-- Label for ID field -->
    <Label text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />

    <!-- TextField for ID input -->
    <TextField fx:id="idField" promptText="Enter department ID" GridPane.columnIndex="1"
               GridPane.rowIndex="0" />

    <!-- Label for Name field -->
    <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="1" />

    <!-- TextField for Name input -->
    <TextField fx:id="nameField" promptText="Enter department name" GridPane.columnIndex="1"
               GridPane.rowIndex="1" />

    <!-- Save button to submit the form -->
    <Button text="Save" onAction="#handleSubmit" GridPane.columnIndex="0" GridPane.rowIndex="2" />

    <!-- Cancel button to close the form without saving -->
    <Button text="Cancel" onAction="#handleCancel" GridPane.columnIndex="1" GridPane.rowIndex="2" />

</GridPane>
